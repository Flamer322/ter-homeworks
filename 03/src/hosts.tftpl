[webservers]
%{ for vm in webservers ~}
${vm.name} ansible_host=${vm.network_interface[0].nat == true ? vm.network_interface[0].nat_ip_address : vm.network_interface[0].ip_address} fqdn=${vm.fqdn}
%{ endfor ~}

[databases]
%{ for vm in databases ~}
${vm.name} ansible_host=${vm.network_interface[0].nat == true ? vm.network_interface[0].nat_ip_address : vm.network_interface[0].ip_address} fqdn=${vm.fqdn}
%{ endfor ~}

[storage]
%{ for vm in storage ~}
${vm.name} ansible_host=${vm.network_interface[0].nat == true ? vm.network_interface[0].nat_ip_address : vm.network_interface[0].ip_address} fqdn=${vm.fqdn}
%{ endfor ~}

[webservers]
%{~ for i in webservers ~}

${i["name"]} ansible_host=${i["network_interface"][0]["nat_ip_address"]} platform_id=${i["platform_id"]}
%{~ endfor ~}
